# Leave the endpoint unset for the deterministic, extractive local demo mode.
APP_NAME=CareBridge
ENVIRONMENT=demo
RUN_MODE=demo
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=Qwen2.5-7B-Instruct
LLM_TIMEOUT_SECONDS=20
LLM_REDFLAG_TIMEOUT_SECONDS=4.0
LLM_GENERATION_TIMEOUT_SECONDS=15.0
LLM_GROUNDING_TIMEOUT_SECONDS=6.0
LLM_MAX_RETRIES=2
LLM_CIRCUIT_BREAKER_THRESHOLD=5
LLM_CIRCUIT_BREAKER_COOLDOWN=30.0

GATE_ENABLED=true
GATE_THRESHOLD=0.65
CONSISTENCY_SAMPLES=3
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

DATABASE_URL=sqlite:///./data/carebridge.db
PATIENTS_FILE=data/patients.json
DOCS_DIR=data/docs
REDFLAGS_DIR=data/redflags
GATE_WEIGHTS_FILE=eval/gate_weights.json
NURSE_PASSWORD=
CORS_ORIGINS=http://localhost:8000
REQUESTS_PER_MINUTE=20
MAX_MESSAGE_LENGTH=1000
EMERGENCY_CONTACT_TEXT=your locally verified emergency services

BACKEND=local
EVOLUS_BASE_URL=
EVOLUS_API_KEY=
EVOLUS_WORKSPACE_ID=
AMD_SERVED=false
SQLITE_VOLUME_PATH=carebridge-data
