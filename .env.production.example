# ==============================================================================
# CareBridge Production Environment Configuration Template
# Copy this file to .env before starting the production deployment.
# NEVER commit the filled .env file with actual keys or passwords to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME=CareBridge
ENVIRONMENT=production

# RUN_MODE must be "live" for production.
# In "live" mode, an LLM_BASE_URL and NURSE_PASSWORD are strictly required.
RUN_MODE=live

# Web server worker concurrency (recommended: 2 to 4 workers per 2-4 GB RAM)
WEB_CONCURRENCY=2

# Port to bind Uvicorn (default: 8000; PaaS platforms like Render/Cloud Run inject $PORT)
PORT=8000

# ------------------------------------------------------------------------------
# 2. REMOTE LANGUAGE MODEL (LLM) CONFIGURATION
# ------------------------------------------------------------------------------
# Must be an OpenAI-compatible /v1 chat completions endpoint.
# Examples:
#   - AMD ROCm vLLM:        http://192.168.1.100:8000/v1
#   - Self-hosted vLLM:     https://vllm.internal.yourorg.com/v1
#   - Ollama:               http://ollama-host:11434/v1
#   - OpenAI:               https://api.openai.com/v1
#   - Groq:                 https://api.groq.com/openai/v1
LLM_BASE_URL=https://your-llm-endpoint.example.com/v1
LLM_API_KEY=your_secret_api_key_here
LLM_MODEL=Qwen2.5-7B-Instruct

# Timeouts in seconds for LLM stages
LLM_TIMEOUT_SECONDS=20
LLM_REDFLAG_TIMEOUT_SECONDS=4.0
LLM_GENERATION_TIMEOUT_SECONDS=15.0
LLM_GROUNDING_TIMEOUT_SECONDS=6.0
LLM_MAX_RETRIES=2
LLM_CIRCUIT_BREAKER_THRESHOLD=5
LLM_CIRCUIT_BREAKER_COOLDOWN=30.0

# Set AMD_SERVED=true ONLY if the LLM is demonstrably hosted on AMD hardware
AMD_SERVED=false

# ------------------------------------------------------------------------------
# 3. CLINICAL SAFETY & CONFIDENCE GATE
# ------------------------------------------------------------------------------
# MUST be true in any user-facing deployment
GATE_ENABLED=true
GATE_THRESHOLD=0.65
CONSISTENCY_SAMPLES=3

# Local Sentence Transformer Embeddings (runs on CPU)
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ------------------------------------------------------------------------------
# 4. PERSISTENCE & DATA STORAGE
# ------------------------------------------------------------------------------
# For container deployments, point to the mounted persistent volume directory
DATABASE_URL=sqlite:////app/runtime-data/carebridge.db
SQLITE_VOLUME_PATH=carebridge-data

PATIENTS_FILE=data/patients.json
DOCS_DIR=data/docs
REDFLAGS_DIR=data/redflags
GATE_WEIGHTS_FILE=eval/gate_weights.json

# ------------------------------------------------------------------------------
# 5. SECURITY & ACCESS CONTROL (CRITICAL)
# ------------------------------------------------------------------------------
# Password for nurse queue routes (/nurse, /api/tickets).
# Generate with: openssl rand -base64 24
NURSE_PASSWORD=generate_a_strong_password_here

# Comma-separated list of allowed origins (e.g., your public domain)
# Examples: https://carebridge.yourdomain.com,https://nurse.yourdomain.com
CORS_ORIGINS=https://carebridge.yourdomain.com

# Rate limiting (requests per minute per client IP)
REQUESTS_PER_MINUTE=20
MAX_MESSAGE_LENGTH=1000

# Emergency contact instruction displayed on red-flag detection
EMERGENCY_CONTACT_TEXT=your local emergency services (e.g. call 911 or visit the nearest emergency room)

# ------------------------------------------------------------------------------
# 6. OPTIONAL INTEGRATIONS
# ------------------------------------------------------------------------------
BACKEND=local
EVOLUS_BASE_URL=
EVOLUS_API_KEY=
EVOLUS_WORKSPACE_ID=
